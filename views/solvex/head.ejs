<!doctype html>
<html lang="ko" data-theme="dark">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · SOLVEX</title>
<meta name="description" content="수학 증명과 알고리즘의 취약점을 찾아 개선하는 올림피아드 학습 플랫폼 SOLVEX.">
<meta property="og:title" content="<%= title %> · SOLVEX"><meta property="og:description" content="정답을 넘어, 사고의 한계를 넘다.">
<% if (typeof canonical !== 'undefined') { %><link rel="canonical" href="<%= baseUrl + canonical %>"><% } %>
<link rel="icon" type="image/svg+xml" href="/solvex-mark.svg">
<% if (typeof applicationPage !== 'undefined' && applicationPage) { %>
<link rel="stylesheet" href="/css/style.css">
<% if (title === '채점 결과') { %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css">
<% } %>
<% } %>
<link rel="stylesheet" href="/css/solvex.css">
<script defer src="/js/solvex.js"></script>
</head><body<% if (typeof applicationPage !== 'undefined' && applicationPage) { %> class="sx-application"<% } %>>
<a class="sx-skip" href="#main">본문으로 건너뛰기</a>
<header class="sx-header"><div class="sx-width sx-bar">
<a class="sx-logo" href="/" aria-label="SOLVEX 홈">SOLVE<img src="/solvex-mark.svg" alt="X" width="21" height="21"></a>
<nav aria-label="주요 메뉴">
  <a href="/lens/math">수학</a><a href="/problems/all">정보 문제</a><a href="/lens">AI 분석실</a><a href="/contests">대회</a><a href="/groups">그룹</a>
  <details class="sx-menu"><summary>더 보기</summary><div class="sx-menu-popover">
    <a href="/problems/steps">단계별 문제</a><a href="/community">커뮤니티</a><a href="/status">채점 현황</a><a href="/ranking">랭킹</a><a href="/tools">도구</a>
  </div></details>
</nav>
<div class="sx-account"><button type="button" data-theme-toggle aria-label="화면 테마 전환">◐</button>
<% if (currentUser) { %><details class="sx-menu"><summary><%= currentUser.username %></summary><div class="sx-menu-popover sx-menu-right">
  <a href="/user/<%= encodeURIComponent(currentUser.username) %>">프로필</a><a href="/analysis-history">내 분석</a><a href="/submissions">내 제출</a><a href="/shop">코인 상점</a><a href="/settings">설정</a>
  <% if (isAdmin) { %><a href="/admin">관리자</a><% } %><% if (isSuperAdmin) { %><a href="/admin/solvex">분석 운영</a><% } %>
  <form action="/logout" method="post"><button type="submit">로그아웃</button></form>
</div></details>
<% } else { %><a href="/login">로그인</a><a class="sx-account-extra" href="/register">가입</a><% } %></div>
</div></header><main id="main" class="sx-width<%= typeof applicationPage !== 'undefined' && applicationPage ? ' main-container' : '' %>">
