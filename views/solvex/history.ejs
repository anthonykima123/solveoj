<%- include('head', {title:'내 분석 기록'}) %><section class="sx-page"><h1>내 분석 기록</h1><p>최근에 저장된 분석 50건을 확인할 수 있습니다.</p></section>
<section class="sx-panel"><% if (!reviews.length) { %><p>저장된 분석이 없습니다.</p><a href="/lens" class="sx-button">분석실 열기 ↗</a><% } %>
<% reviews.forEach(item => { %><p><a href="/analysis-history/<%= item.id %>"><%= item.kind === 'math' ? '수학 풀이 분석' : '코드 분석' %> ↗</a> · <%= new Date(item.created_at).toLocaleString('ko-KR', {timeZone:'Asia/Seoul'}) %></p><% }); %></section><%- include('foot') %>
