<% const math = kind === 'math'; const name = math ? 'Math Lens' : 'Code Lens'; %>
<%- include('head', {title:name, canonical:'/lens/' + kind}) %>
<section class="sx-page"><p class="sx-kicker">SOLVEX / AI 분석실</p><h1><%= name %></h1>
<p><%= math ? '증명의 연결을 검토하고, 어디에 근거를 보강해야 할지 확인하세요.' : '알고리즘의 약점과 경계 조건을 살펴보세요. 코드는 실행하지 않습니다.' %></p>
<div class="sx-actions"><a class="sx-button <%= math ? 'primary' : '' %>" href="/lens/math">수학 풀이</a><a class="sx-button <%= !math ? 'primary' : '' %>" href="/lens/code">코드</a><a class="sx-button" href="/lens/<%= kind %>?example=1">고정 예시 열기 ↗</a></div></section>
<% if (math) { %><p><a class="sx-button" href="/lens/math/counterexample">지금 바로 반례 제출·검증 ↗</a></p><% } %>
<% if (example) { %><div class="sx-grid sx-work"><section class="sx-panel"><p class="sx-kicker">고정 데모 / 입력</p><h2>문제</h2><p><%= example.problem %></p><h2><%= math ? '제출 예시' : '코드 예시' %></h2><pre><%= example.answer %></pre></section>
<%- include('report', {result:example.result, kind, points:example.max, sample:true}) %></div><% } %>
<section class="sx-panel sx-lab"><h2>내 <%= math ? '풀이' : '코드' %> 분석하기</h2>
<% if (!ready) { %><p class="sx-callout">로그인 없이 이 브라우저에서 분석합니다. 첫 실행에는 모델 다운로드가 필요합니다. WebGPU가 없으면 CPU가 실행하며 처음에는 약 390MB를 내려받습니다. 입력과 결과는 서버로 전송하거나 저장하지 않습니다.</p><% } %>
<% if (ready && providerName === 'OpenAI') { %><p class="sx-callout">OpenAI 서버에서 분석합니다. 모델 다운로드나 WebGPU가 필요 없습니다.</p><% } %>
<% const inputLimit = ready ? maxInput : Math.min(maxInput, 2500); %>
<form data-lens data-max="<%= inputLimit %>" data-token="<%= csrfToken %>" <% if (ready) { %>action="/lens/<%= kind %>" method="post" enctype="multipart/form-data"<% } else { %>data-local-review="<%= kind %>" method="dialog"<% } %>>
<div class="sx-grid sx-work"><label>문제 본문<textarea name="problem" rows="9" maxlength="<%= inputLimit %>" <%= ready ? '' : 'required' %> spellcheck="false" placeholder="조건이 포함된 문제를 입력하세요."><%= prefill.slice(0, inputLimit) %></textarea></label>
<label><%= math ? '분석할 증명' : '분석할 코드' %><textarea class="<%= math ? '' : 'sx-code' %>" name="answer" rows="9" maxlength="<%= inputLimit %>" <%= ready ? '' : 'required' %> spellcheck="false" placeholder="<%= math ? '풀이 과정을 순서대로 적어 주세요.' : '분석할 소스 코드를 붙여넣으세요.' %>"></textarea></label></div>
<div class="sx-form-group">
<% if (math) { %><label>전체 배점 <input name="max" type="number" min="1" max="100" value="7" required></label><% if (allowImages) { %><label data-drop class="sx-drop">손글씨 사진 · PNG/JPEG, 최대 1MB<input name="image" type="file" accept="image/png,image/jpeg"><span data-file aria-live="polite"></span><img data-photo alt="첨부한 풀이 사진 미리보기" hidden></label><% } %>
<% } else { %><label>언어 <select name="language"><option>C++17</option><option>C++20</option><option>Python 3</option><option>Java 11</option></select></label><% } %>
</div>
<label><%= math ? '참고 풀이 또는 맥락' : '제한, 오류 메시지 또는 채점 결과' %> (선택)<textarea name="context" rows="3" maxlength="<%= inputLimit %>"></textarea></label>
<p data-count class="sx-muted"></p>
<% if (ready && currentUser) { %><label class="sx-consent"><input type="checkbox" name="consent" value="<%= providerName === 'OpenAI' ? 'openai' : 'yes' %>" required>
<%= providerName === 'OpenAI' ? '문제·풀이·코드와 참고 텍스트를 분석 목적으로 OpenAI에 전송하는 데 동의합니다. 이름, 학교 등 개인정보를 입력하지 마세요.' : '입력 내용과 첨부 사진을 Google Gemini로 전송하는 데 동의합니다. 이름 등 개인정보를 제거해 주세요.' %></label>
<button class="sx-button primary" type="submit"><%= providerName === 'OpenAI' ? 'OpenAI로 분석' : '분석 시작 ↗' %></button><% } else { %>
<button class="sx-button primary" type="submit" data-local-start disabled>AI 분석 시작</button>
<button class="sx-button" type="button" data-local-cancel hidden>취소</button>
<progress data-local-progress max="1" aria-label="모델 준비 진행률" hidden></progress>
<% } %>
<noscript>직접 분석에는 JavaScript가 필요합니다.</noscript><p data-status role="status"></p>
</form></section>
<% if (!ready) { %><section class="sx-panel sx-report sx-local-result" data-local-result tabindex="-1" aria-label="AI 분석 결과" hidden></section>
<script type="module" src="/js/local-ai.mjs"></script><% } %>
<%- include('foot') %>
