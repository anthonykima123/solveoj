<% locals.title = '그룹' %>
<%- include('../partials/header') %>

<div class="page-header">
  <h1>그룹</h1>
  <% if (user) { %>
    <a href="/groups/new" class="btn">그룹 만들기</a>
  <% } %>
</div>

<div class="card-grid">
  <% if (groups.length === 0) { %>
    <p class="empty-row">아직 그룹이 없습니다. 첫 그룹을 만들어보세요!</p>
  <% } %>
  <% groups.forEach(g => { %>
    <a href="/groups/<%= g.id %>" class="card group-card">
      <h3><%= g.name %></h3>
      <p class="muted"><%= (g.description || '').slice(0, 80) %></p>
      <div class="muted">그룹장 <%= g.owner_name %> · 멤버 <%= (g.members || []).length %>명</div>
    </a>
  <% }) %>
</div>

<%- include('../partials/footer') %>
