<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>SolveOJ</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css">
</head>
<body>
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-mark">S</span>
      <span>SolveOJ</span>
    </a>
    <nav class="nav-main" aria-label="주요 메뉴">
      <div class="nav-item has-drop">
        <a href="/problems">문제</a>
        <div class="nav-drop">
          <a href="/problems/jungol">정올</a>
          <a href="/problems/icpc">ICPC</a>
          <a href="/problems/usaco">USACO</a>
          <a href="/problems/steps">단계별 문제</a>
        </div>
      </div>
      <a href="/contests">대회</a>
      <a href="/groups">그룹</a>
      <a href="/community">커뮤니티</a>
      <div class="nav-item has-drop">
        <a href="/tools">도구</a>
        <div class="nav-drop">
          <a href="/tools/compiler">⚡ 온라인 컴파일러</a>
          <a href="/tools/notes">📝 노트</a>
          <a href="/tools/paint">🎨 그림판</a>
        </div>
      </div>
      <a href="/status">채점 현황</a>
      <a href="/ranking">랭킹</a>
      <% if (user) { %><a href="/user/<%= user.username %>">프로필</a><% } %>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a href="/admin" class="nav-admin">관리자</a>
      <% } %>
    </nav>
    <div class="nav-auth">
      <% if (user) { %>
        <% const _ti = getTierInfo(user.rating || 0); %>
        <span class="tier-badge tier-badge-<%= _ti.cls %> tier-sm" title="<%= _ti.tier %>">
          <span class="tier-icon"><%= getTierShort(_ti.tier) %></span>
          <span class="tier-name"><%= _ti.tier %></span>
        </span>
        <a href="/user/<%= user.username %>" class="username-badge"><%= user.username %></a>
        <a href="/shop" class="coin-nav-badge" title="코인 샵">🪙 <%= currentUser ? (currentUser.coins || 0).toLocaleString() : 0 %></a>
        <a href="/submissions">내 제출</a>
        <a href="/settings">설정</a>
        <form action="/logout" method="POST" class="logout-form">
          <button type="submit" class="btn-logout">로그아웃</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn-login">로그인</a>
        <a href="/register" class="btn-register">회원가입</a>
      <% } %>
    </div>
  </div>
</header>
<main class="main-container">
