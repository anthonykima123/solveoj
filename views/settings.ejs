<% locals.title = '계정 설정' %>
<%- include('partials/header') %>

<div class="settings-wrap">
  <h1 class="settings-title">계정 설정</h1>

  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="settings-card settings-card-full">
    <h2>프로필 이미지</h2>
    <form action="/settings/images" method="POST" id="img-form">
      <input type="hidden" name="avatar" id="avatar-field" value="<%= currentUser && currentUser.avatar_url ? currentUser.avatar_url : '' %>">
      <div class="img-edit">
        <label class="img-edit-label">프로필 사진</label>
        <div class="avatar-preview-wrap">
          <img id="avatar-preview" class="avatar-preview"
               src="<%= currentUser && currentUser.avatar_url ? currentUser.avatar_url : '' %>"
               alt="" <%= currentUser && currentUser.avatar_url ? '' : 'style=display:none' %>>
          <div id="avatar-placeholder" class="avatar-preview avatar-placeholder" <%= currentUser && currentUser.avatar_url ? 'style=display:none' : '' %>>없음</div>
        </div>
        <div class="img-btns">
          <label class="btn btn-outline btn-sm">파일 선택<input type="file" accept="image/*" id="avatar-input" hidden></label>
          <button type="button" class="btn btn-danger btn-sm" id="avatar-remove">제거</button>
        </div>
      </div>
      <p class="muted" style="margin:10px 0">JPG·PNG 권장. 자동으로 256×256으로 압축됩니다.</p>
      <button type="submit" class="btn btn-primary">저장</button>
    </form>
  </div>

  <div class="settings-card settings-card-full" style="display:flex;align-items:center;justify-content:space-between;gap:16px">
    <div>
      <h2 style="margin:0 0 4px">프로필 배너</h2>
      <p class="muted" style="margin:0">배너는 코인 샵에서 구매하고 착용할 수 있습니다.</p>
    </div>
    <a href="/shop" class="btn btn-primary">🪙 코인 샵 바로가기</a>
  </div>

  <div class="settings-grid">
    <div class="settings-card">
      <h2>아이디 변경</h2>
      <form action="/settings/username" method="POST" class="auth-form">
        <div class="form-group">
          <label>새 아이디</label>
          <input type="text" name="username" class="form-input" value="<%= user.username %>" required>
        </div>
        <button type="submit" class="btn btn-primary">변경</button>
      </form>
    </div>

    <div class="settings-card">
      <h2>비밀번호 변경</h2>
      <form action="/settings/password" method="POST" class="auth-form">
        <div class="form-group">
          <label>현재 비밀번호</label>
          <input type="password" name="current_password" class="form-input" required>
        </div>
        <div class="form-group">
          <label>새 비밀번호</label>
          <input type="password" name="new_password" class="form-input" placeholder="6자 이상" required>
        </div>
        <div class="form-group">
          <label>새 비밀번호 확인</label>
          <input type="password" name="new_password2" class="form-input" required>
        </div>
        <button type="submit" class="btn btn-primary">변경</button>
      </form>
    </div>
  </div>
</div>

<script>
(function () {
  function resize(file, maxW, maxH, quality, cb) {
    const reader = new FileReader();
    reader.onload = e => {
      const img = new Image();
      img.onload = () => {
        let w = img.width, h = img.height;
        const r = Math.min(maxW / w, maxH / h, 1);
        w = Math.round(w * r); h = Math.round(h * r);
        const c = document.createElement('canvas');
        c.width = w; c.height = h;
        c.getContext('2d').drawImage(img, 0, 0, w, h);
        cb(c.toDataURL('image/jpeg', quality));
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }
  const input = document.getElementById('avatar-input');
  const field = document.getElementById('avatar-field');
  const preview = document.getElementById('avatar-preview');
  const placeholder = document.getElementById('avatar-placeholder');
  input.addEventListener('change', () => {
    const f = input.files[0];
    if (!f) return;
    resize(f, 256, 256, 0.85, dataUrl => {
      field.value = dataUrl;
      preview.src = dataUrl; preview.style.display = '';
      placeholder.style.display = 'none';
    });
  });
  document.getElementById('avatar-remove').addEventListener('click', () => {
    field.value = '';
    preview.src = ''; preview.style.display = 'none';
    placeholder.style.display = '';
    input.value = '';
  });
})();
</script>

<%- include('partials/footer') %>
