<% locals.title = 'Admin - 유저 관리' %>
<% locals.active = 'users' %>
<%- include('../partials/header') %>

<div class="page-header admin-header">
  <div>
    <h1>🛠 Admin</h1>
    <p class="page-desc">전체 유저를 한눈에 관리합니다.</p>
  </div>
</div>

<%- include('../partials/admin-tabs', { active: 'users' }) %>

<% if (query.deluser) { %>
  <div class="alert alert-success"><strong><%= query.deluser %></strong> 유저를 삭제했습니다.</div>
<% } else if (query.pwreset) { %>
  <div class="alert alert-success"><strong><%= query.pwreset %></strong> 님의 비밀번호를 <code>reset1234</code> 로 초기화했습니다.</div>
<% } else if (query.err === 'superadmin') { %>
  <div class="alert alert-error">슈퍼 관리자 계정은 변경/삭제할 수 없습니다.</div>
<% } else if (query.err === 'self') { %>
  <div class="alert alert-error">자기 자신은 삭제할 수 없습니다.</div>
<% } else if (query.err === 'noadmin') { %>
  <div class="alert alert-error">다른 관리자는 슈퍼 관리자만 삭제할 수 있습니다.</div>
<% } else if (query.rankban) { %>
  <div class="alert alert-success"><strong><%= query.rankban %></strong> 님을 랭킹에서 제외했습니다.</div>
<% } else if (query.rankunban) { %>
  <div class="alert alert-success"><strong><%= query.rankunban %></strong> 님의 랭킹 제외를 해제했습니다.</div>
<% } else if (query.comban) { %>
  <div class="alert alert-success"><strong><%= query.comban %></strong> 님에게 커뮤니티 밴을 적용했습니다.</div>
<% } else if (query.comunban) { %>
  <div class="alert alert-success"><strong><%= query.comunban %></strong> 님의 커뮤니티 밴을 해제했습니다.</div>
<% } else if (query.bannergrant) { %>
  <div class="alert alert-success"><strong><%= query.bannergrant %></strong> 님에게 배너를 지급했습니다.</div>
<% } else if (query.coingrant) { %>
  <div class="alert alert-success"><strong><%= query.coingrant %></strong> 님에게 코인을 지급했습니다.</div>
<% } %>

<div class="admin-summary">
  전체 유저 <strong><%= users.length %></strong>명 ·
  관리자 <strong><%= users.filter(u => u.role==='superadmin' || u.role==='admin').length %></strong>명
</div>

<div class="table-wrap">
  <table class="table admin-user-table">
    <thead>
      <tr>
        <th>#</th>
        <th>사용자</th>
        <th>역할</th>
        <th>통계</th>
        <th>가입일</th>
        <th>관리</th>
      </tr>
    </thead>
    <tbody>
      <% if (users.length === 0) { %>
        <tr><td colspan="6" class="empty-row">유저가 없습니다.</td></tr>
      <% } %>
      <% users.forEach(u => { %>
        <% const ti = getTierInfo(u.rating || 0) %>
        <% const isSuper = u.role === 'superadmin' %>
        <% const isCoAdmin = u.role === 'admin' %>
        <tr class="user-main-row">
          <td><%= u.id %></td>
          <td>
            <span class="tier-badge tier-badge-<%= ti.cls %> tier-sm" title="<%= ti.tier %>">
              <span class="tier-icon"><%= getTierShort(ti.tier) %></span>
              <span class="tier-name"><%= ti.tier %></span>
            </span>
            <a href="/user/<%= encodeURIComponent(u.username) %>" class="profile-link"><strong><%= u.username %></strong></a>
            <% if (u.id === me.id) { %><span class="me-tag">나</span><% } %>
            <div class="user-email"><%= u.email || '' %></div>
          </td>
          <td>
            <% if (isSuper) { %>
              <span class="role-badge role-super">👑 슈퍼 관리자</span>
            <% } else if (isCoAdmin) { %>
              <span class="role-badge role-admin">🛡 공동 관리자</span>
            <% } else { %>
              <span class="role-badge role-user">일반</span>
            <% } %>
            <% if (u.ranking_banned) { %><span class="badge" style="background:#dc3545;color:#fff;font-size:11px">랭킹제외</span><% } %>
            <% if (u.community_banned) { %><span class="badge" style="background:#fd7e14;color:#fff;font-size:11px">커뮤밴</span><% } %>
          </td>
          <td class="user-stats">
            <span title="푼 문제">✅ <%= u.solved_count || 0 %></span>
            <span title="제출 수">📨 <%= u.submission_count || 0 %></span>
            <span title="레이팅">⭐ <%= u.rating || 0 %></span>
          </td>
          <td class="cell-date"><%= u.created_at ? new Date(u.created_at).toLocaleDateString('ko-KR') : '-' %></td>
          <td class="admin-actions admin-user-actions">
            <% if (isSuper) { %>
              <span class="muted-sm">변경 불가</span>
            <% } else { %>
              <form action="/admin/users/<%= u.id %>/toggle-ranking-ban" method="POST" style="display:inline">
                <button class="btn btn-sm <%= u.ranking_banned ? 'btn-outline' : 'btn-outline' %>"
                        style="<%= u.ranking_banned ? 'border-color:#dc3545;color:#dc3545' : '' %>"
                        title="<%= u.ranking_banned ? '랭킹 제외 해제' : '랭킹에서 제외' %>">
                  <%= u.ranking_banned ? '랭킹복귀' : '랭킹제외' %>
                </button>
              </form>
              <form action="/admin/users/<%= u.id %>/toggle-community-ban" method="POST" style="display:inline">
                <button class="btn btn-sm btn-outline"
                        style="<%= u.community_banned ? 'border-color:#fd7e14;color:#fd7e14' : '' %>"
                        title="<%= u.community_banned ? '커뮤니티 밴 해제' : '커뮤니티 밴' %>">
                  <%= u.community_banned ? '밴해제' : '커뮤밴' %>
                </button>
              </form>
              <% if (u.id !== me.id && !(isCoAdmin && me.role !== 'superadmin')) { %>
                <form action="/admin/users/<%= u.id %>/reset-password" method="POST" style="display:inline"
                      onsubmit="return confirm('<%= u.username %> 님의 비밀번호를 reset1234로 초기화할까요?')">
                  <button class="btn btn-sm btn-outline">비번초기화</button>
                </form>
                <form action="/admin/users/<%= u.id %>/delete" method="POST" style="display:inline"
                      onsubmit="return confirm('<%= u.username %> 유저를 삭제하시겠습니까? 제출 기록도 함께 삭제됩니다.')">
                  <button class="btn btn-sm btn-danger">삭제</button>
                </form>
              <% } %>
              <button class="btn btn-sm btn-outline" onclick="toggleGrant(<%= u.id %>)" style="color:#7c3aed;border-color:#7c3aed">지급</button>
            <% } %>
          </td>
        </tr>
        <tr class="grant-row" id="grant-<%= u.id %>" style="display:none">
          <td colspan="6" style="background:#f8f7ff;padding:10px 16px">
            <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end">
              <form action="/admin/users/<%= u.id %>/grant-banner" method="POST" style="display:flex;gap:6px;align-items:center">
                <label style="font-size:.8rem;font-weight:700;color:#7c3aed">배너 지급</label>
                <select name="banner_id" class="form-input" style="padding:4px 8px;font-size:.82rem;width:auto">
                  <% BANNERS.forEach(b => { %><option value="<%= b.id %>"><%= b.name %> (<%= ({common:'일반',rare:'희귀',epic:'에픽',legendary:'전설'})[b.rarity] %>)</option><% }) %>
                </select>
                <button class="btn btn-sm" style="background:#7c3aed;color:#fff">지급</button>
              </form>
              <form action="/admin/users/<%= u.id %>/grant-coins" method="POST" style="display:flex;gap:6px;align-items:center">
                <label style="font-size:.8rem;font-weight:700;color:#f59e0b">🪙 코인 지급</label>
                <input type="number" name="amount" min="1" value="100" class="form-input" style="width:90px;padding:4px 8px;font-size:.82rem">
                <button class="btn btn-sm" style="background:#f59e0b;color:#fff">지급</button>
              </form>
              <span style="font-size:.8rem;color:#64748b">보유 코인: <strong><%= u.coins || 0 %></strong></span>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
function toggleGrant(id) {
  const row = document.getElementById('grant-' + id);
  row.style.display = row.style.display === 'none' ? '' : 'none';
}
</script>

<%- include('../partials/footer') %>
