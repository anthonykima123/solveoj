<% locals.title = 'Admin - 유저 관리' %>
<% locals.active = 'users' %>
<%- include('../partials/header') %>

<div class="page-header admin-header">
  <div>
    <h1>🛠 Admin</h1>
    <p class="page-desc">전체 유저를 한눈에 관리합니다.</p>
  </div>
</div>

<%- include('../partials/admin-tabs', { active: 'users' }) %>

<% if (query.deluser) { %>
  <div class="alert alert-success"><strong><%= query.deluser %></strong> 유저를 삭제했습니다.</div>
<% } else if (query.pwreset) { %>
  <div class="alert alert-success"><strong><%= query.pwreset %></strong> 님의 비밀번호를 <code>reset1234</code> 로 초기화했습니다.</div>
<% } else if (query.err === 'superadmin') { %>
  <div class="alert alert-error">슈퍼 관리자 계정은 변경/삭제할 수 없습니다.</div>
<% } else if (query.err === 'self') { %>
  <div class="alert alert-error">자기 자신은 삭제할 수 없습니다.</div>
<% } else if (query.err === 'noadmin') { %>
  <div class="alert alert-error">다른 관리자는 슈퍼 관리자만 삭제할 수 있습니다.</div>
<% } %>

<div class="admin-summary">
  전체 유저 <strong><%= users.length %></strong>명 ·
  관리자 <strong><%= users.filter(u => u.role==='superadmin' || u.role==='admin').length %></strong>명
</div>

<div class="table-wrap">
  <table class="table admin-user-table">
    <thead>
      <tr>
        <th>#</th>
        <th>사용자</th>
        <th>역할</th>
        <th>통계</th>
        <th>가입일</th>
        <th>관리</th>
      </tr>
    </thead>
    <tbody>
      <% if (users.length === 0) { %>
        <tr><td colspan="6" class="empty-row">유저가 없습니다.</td></tr>
      <% } %>
      <% users.forEach(u => { %>
        <% const ti = getTierInfo(u.rating || 0) %>
        <% const isSuper = u.role === 'superadmin' %>
        <% const isCoAdmin = u.role === 'admin' %>
        <tr>
          <td><%= u.id %></td>
          <td>
            <span class="user-tier-badge tier-<%= ti.cls %> tier-sm"><%= ti.tier %></span>
            <a href="/user/<%= encodeURIComponent(u.username) %>" class="profile-link"><strong><%= u.username %></strong></a>
            <% if (u.id === me.id) { %><span class="me-tag">나</span><% } %>
            <div class="user-email"><%= u.email || '' %></div>
          </td>
          <td>
            <% if (isSuper) { %>
              <span class="role-badge role-super">👑 슈퍼 관리자</span>
            <% } else if (isCoAdmin) { %>
              <span class="role-badge role-admin">🛡 공동 관리자</span>
            <% } else { %>
              <span class="role-badge role-user">일반</span>
            <% } %>
          </td>
          <td class="user-stats">
            <span title="푼 문제">✅ <%= u.solved_count || 0 %></span>
            <span title="제출 수">📨 <%= u.submission_count || 0 %></span>
            <span title="레이팅">⭐ <%= u.rating || 0 %></span>
          </td>
          <td class="cell-date"><%= u.created_at ? new Date(u.created_at).toLocaleDateString('ko-KR') : '-' %></td>
          <td class="admin-actions admin-user-actions">
            <% if (isSuper) { %>
              <span class="muted-sm">변경 불가</span>
            <% } else if (u.id !== me.id && !(isCoAdmin && !isSuperAdmin)) { %>
              <form action="/admin/users/<%= u.id %>/reset-password" method="POST" style="display:inline"
                    onsubmit="return confirm('<%= u.username %> 님의 비밀번호를 reset1234로 초기화할까요?')">
                <button class="btn btn-sm btn-outline">비번 초기화</button>
              </form>
              <form action="/admin/users/<%= u.id %>/delete" method="POST" style="display:inline"
                    onsubmit="return confirm('<%= u.username %> 유저를 삭제하시겠습니까? 제출 기록도 함께 삭제됩니다.')">
                <button class="btn btn-sm btn-danger">삭제</button>
              </form>
            <% } else { %>
              <span class="muted-sm">—</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
