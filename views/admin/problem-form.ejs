<% const isEdit = problem && problem.id %>
<% locals.title = isEdit ? `문제 수정 - #${problem.id}` : '새 문제 추가' %>
<%- include('../partials/header') %>

<div class="admin-form-wrap">
  <div class="page-header">
    <h1><%= isEdit ? `문제 #${problem.id} 수정` : '새 문제 추가' %></h1>
    <a href="/admin" class="btn btn-outline">← 관리자 패널</a>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <form action="/admin/problems/<%= isEdit ? problem.id + '/edit' : 'new' %>" method="POST" class="admin-form">

    <div class="form-row">
      <div class="form-group" style="width:120px">
        <label>문제 번호 *</label>
        <input type="number" name="id" class="form-input"
               value="<%= problem ? problem.id : '' %>"
               <%= isEdit ? 'readonly' : 'required' %>>
      </div>
      <div class="form-group" style="flex:1">
        <label>제목 *</label>
        <input type="text" name="title" class="form-input" required
               value="<%= problem ? problem.title : '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label>난이도 * (BOJ 기준)</label>
        <select name="difficulty" class="form-input" required>
          <% tiers.forEach(t => { %>
            <option value="<%= t %>" <%= (problem && problem.difficulty === t) ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="width:140px">
        <label>시간 제한 (ms)</label>
        <input type="number" name="time_limit" class="form-input"
               value="<%= problem ? problem.time_limit : 1000 %>">
      </div>
      <div class="form-group" style="width:140px">
        <label>메모리 제한 (MB)</label>
        <input type="number" name="memory_limit" class="form-input"
               value="<%= problem ? problem.memory_limit : 256 %>">
      </div>
      <div class="form-group" style="width:200px">
        <label>단계 (단계별 문제)</label>
        <select name="step" class="form-input">
          <option value="">단계 없음</option>
          <% (typeof steps !== 'undefined' ? steps : []).forEach(s => { %>
            <option value="<%= s.id %>" <%= (problem && Number(problem.step) === s.id) ? 'selected' : '' %>><%= s.order || s.id %>. <%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="width:160px">
        <label>기출 분류</label>
        <select name="contest" class="form-input">
          <% const _ct = problem ? problem.contest : ''; %>
          <option value="" <%= !_ct ? 'selected' : '' %>>없음</option>
          <option value="jungol" <%= _ct === 'jungol' ? 'selected' : '' %>>정올</option>
          <option value="koi" <%= _ct === 'koi' ? 'selected' : '' %>>KOI</option>
          <option value="icpc" <%= _ct === 'icpc' ? 'selected' : '' %>>ICPC</option>
          <option value="usaco" <%= _ct === 'usaco' ? 'selected' : '' %>>USACO</option>
        </select>
      </div>
      <div class="form-group" style="width:130px">
        <label>공개 설정</label>
        <select name="visibility" class="form-input">
          <option value="public" <%= (!problem || !problem.is_private) ? 'selected' : '' %>>공개</option>
          <option value="private" <%= (problem && problem.is_private) ? 'selected' : '' %>>비공개</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label>문제 설명 *</label>
      <textarea name="description" class="form-textarea" rows="5" required><%= problem ? problem.description : '' %></textarea>
    </div>

    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label>입력 설명</label>
        <textarea name="input_desc" class="form-textarea" rows="3"><%= problem ? problem.input_desc : '' %></textarea>
      </div>
      <div class="form-group" style="flex:1">
        <label>출력 설명</label>
        <textarea name="output_desc" class="form-textarea" rows="3"><%= problem ? problem.output_desc : '' %></textarea>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label>예제 입력</label>
        <textarea name="sample_input" class="form-textarea mono" rows="4"><%= problem ? problem.sample_input : '' %></textarea>
      </div>
      <div class="form-group" style="flex:1">
        <label>예제 출력</label>
        <textarea name="sample_output" class="form-textarea mono" rows="4"><%= problem ? problem.sample_output : '' %></textarea>
      </div>
    </div>

    <div class="form-group">
      <label>제약 조건</label>
      <input type="text" name="constraints" class="form-input"
             value="<%= problem ? problem.constraints : '' %>">
    </div>

    <div class="form-group">
      <label>
        테스트 케이스 (JSON)
        <span class="hint">형식: <code>[{"input":"1 2","output":"3"}, ...]</code></span>
      </label>
      <textarea name="test_cases_raw" id="tc-editor" class="form-textarea mono" rows="10" required><%= problem ? problem.test_cases : '[\n  {"input": "", "output": ""}\n]' %></textarea>
      <div class="tc-toolbar">
        <button type="button" class="btn btn-sm btn-outline" onclick="addTestCase()">+ 케이스 추가</button>
        <button type="button" class="btn btn-sm btn-outline" onclick="formatTC()">정렬/포맷</button>
        <label class="btn btn-sm btn-outline" style="cursor:pointer;margin:0">
          파일 업로드 (JSON/ZIP)
          <input type="file" id="tc-file" accept=".json,.zip" style="display:none" onchange="uploadTCFile(this)">
        </label>
        <span id="tc-status" class="tc-status"></span>
      </div>
      <p class="hint" style="margin-top:6px">ZIP 형식: <code>1.in / 1.out</code> 또는 <code>input1.txt / output1.txt</code> 쌍으로 구성</p>
    </div>

    <div class="form-group">
      <label style="font-weight:600">
        <input type="checkbox" name="special_judge" id="sj-toggle"
               <%= (problem && problem.special_judge) ? 'checked' : '' %>
               onchange="document.getElementById('checker-section').style.display=this.checked?'block':'none'">
        스페셜 저지 (Special Judge)
        <span class="hint">체커 코드가 정답 여부를 판단합니다 (부동소수점 오차, 다중 정답 등)</span>
      </label>
    </div>
    <div id="checker-section" style="display:<%= (problem && problem.special_judge) ? 'block' : 'none' %>">
      <div class="form-group">
        <label>
          체커 코드 (JavaScript)
          <span class="hint"><code>function check(input, expected, actual)</code> — true 반환 시 AC</span>
        </label>
        <textarea name="checker_code" id="checker-editor" class="form-textarea mono" rows="12"><%= (problem && problem.checker_code) ? problem.checker_code : `function check(input, expected, actual) {
  // input    : 문제 입력 (원본 문자열)
  // expected : 정답 출력 (원본 문자열)
  // actual   : 제출자 출력 (원본 문자열)
  // true 반환 → AC,  false 반환 → WA
  return actual.trim() === expected.trim();
}` %></textarea>
      </div>
    </div>

    <div class="form-submit">
      <button type="submit" class="btn btn-primary btn-lg">
        <%= isEdit ? '문제 저장' : '문제 생성' %>
      </button>
      <a href="/admin" class="btn btn-outline btn-lg">취소</a>
    </div>
  </form>
</div>

<script>
function formatTC() {
  const ta = document.getElementById('tc-editor');
  try {
    const parsed = JSON.parse(ta.value);
    ta.value = JSON.stringify(parsed, null, 2);
    document.getElementById('tc-status').textContent = '✔ 유효한 JSON';
    document.getElementById('tc-status').style.color = '#1a7f37';
  } catch (e) {
    document.getElementById('tc-status').textContent = '✗ JSON 오류: ' + e.message;
    document.getElementById('tc-status').style.color = '#d1242f';
  }
}

function addTestCase() {
  const ta = document.getElementById('tc-editor');
  try {
    const arr = JSON.parse(ta.value);
    arr.push({ input: '', output: '' });
    ta.value = JSON.stringify(arr, null, 2);
  } catch (e) {
    ta.value = JSON.stringify([{ input: '', output: '' }], null, 2);
  }
}

document.getElementById('tc-editor').addEventListener('input', function() {
  try {
    JSON.parse(this.value);
    document.getElementById('tc-status').textContent = '✔ 유효한 JSON';
    document.getElementById('tc-status').style.color = '#1a7f37';
  } catch (e) {
    document.getElementById('tc-status').textContent = '✗ JSON 오류';
    document.getElementById('tc-status').style.color = '#d1242f';
  }
});

async function uploadTCFile(input) {
  const file = input.files[0];
  if (!file) return;
  const status = document.getElementById('tc-status');
  status.textContent = '업로드 중...';
  status.style.color = '#666';
  const fd = new FormData();
  fd.append('file', file);
  try {
    const res = await fetch('/admin/problems/parse-testcases', { method: 'POST', body: fd });
    const data = await res.json();
    if (data.error) {
      status.textContent = '✗ ' + data.error;
      status.style.color = '#d1242f';
    } else {
      document.getElementById('tc-editor').value = JSON.stringify(data.testCases, null, 2);
      status.textContent = `✔ ${data.testCases.length}개 케이스 로드됨`;
      status.style.color = '#1a7f37';
    }
  } catch (e) {
    status.textContent = '✗ 업로드 실패';
    status.style.color = '#d1242f';
  }
  input.value = '';
}
</script>

<%- include('../partials/footer') %>
