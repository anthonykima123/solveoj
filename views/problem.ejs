<% locals.title = problem.title %>
<%- include('partials/header') %>

<div class="problem-wrap">
  <div class="problem-header">
    <div class="problem-meta-top">
      <span class="problem-number"><%= problem.id %></span>
      <span class="badge badge-<%= problem.difficulty.toLowerCase() %>"><%= problem.difficulty %></span>
      <% if (isSolved) { %><span class="solved-tag">✔ 풀었음</span><% } %>
    </div>
    <h1 class="problem-title"><%= problem.title %></h1>
    <div class="problem-limits">
      <span>시간 제한: <strong><%= problem.time_limit %>ms</strong></span>
      <span>메모리 제한: <strong><%= problem.memory_limit %>MB</strong></span>
    </div>

    <% if ((problem.tags || []).length > 0) { %>
    <div class="problem-tags">
      <% (problem.tags || []).forEach(t => { %>
        <a href="/problems?tag=<%= encodeURIComponent(t) %>" class="tag-chip tag-chip-lg"><%= t %></a>
      <% }) %>
    </div>
    <% } %>

    <div class="problem-rating">
      <div class="star-rating" id="star-rating" data-pid="<%= problem.id %>" data-my="<%= myRating %>">
        <% for(let i=1; i<=5; i++) { %>
          <span class="star <%= i <= myRating ? 'active' : '' %>" data-val="<%= i %>">★</span>
        <% } %>
      </div>
      <span class="rating-info" id="rating-info">
        <% if (ratingInfo.count > 0) { %>
          <strong><%= ratingInfo.avg %></strong> / 5 &nbsp;(<%= ratingInfo.count %>명 평가)
        <% } else { %>
          아직 평가 없음
        <% } %>
      </span>
    </div>
  </div>

  <div class="problem-section">
    <h2>문제</h2>
    <div class="problem-desc"><%= problem.description %></div>
  </div>

  <% if (problem.input_desc) { %>
  <div class="problem-section">
    <h2>입력</h2>
    <div class="problem-desc"><%= problem.input_desc %></div>
  </div>
  <% } %>

  <% if (problem.output_desc) { %>
  <div class="problem-section">
    <h2>출력</h2>
    <div class="problem-desc"><%= problem.output_desc %></div>
  </div>
  <% } %>

  <% if (problem.constraints) { %>
  <div class="problem-section">
    <h2>제약 조건</h2>
    <div class="problem-desc"><%= problem.constraints %></div>
  </div>
  <% } %>

  <% if (problem.sample_input !== null && problem.sample_input !== undefined) { %>
  <div class="sample-io-grid">
    <div class="sample-box">
      <h2>예제 입력 1</h2>
      <pre class="sample-pre"><%= problem.sample_input || '(입력 없음)' %></pre>
    </div>
    <div class="sample-box">
      <h2>예제 출력 1</h2>
      <pre class="sample-pre"><%= problem.sample_output %></pre>
    </div>
  </div>
  <% } %>

  <div class="submit-action">
    <% if (user) { %>
      <a href="/problems/<%= problem.id %>/submit" class="btn btn-primary btn-lg">제출하기</a>
    <% } else { %>
      <a href="/login?next=/problems/<%= problem.id %>/submit" class="btn btn-primary btn-lg">로그인 후 제출</a>
    <% } %>
    <a href="/problems" class="btn btn-outline">목록으로</a>
  </div>
</div>

<script>
const starEl = document.getElementById('star-rating');
if (starEl) {
  const stars = starEl.querySelectorAll('.star');
  const pid = starEl.dataset.pid;
  const isLoggedIn = <%= user ? 'true' : 'false' %>;

  stars.forEach(s => {
    s.addEventListener('mouseover', () => {
      stars.forEach(x => x.classList.toggle('hover', x.dataset.val <= s.dataset.val));
    });
    s.addEventListener('mouseout', () => {
      stars.forEach(x => x.classList.remove('hover'));
    });
    s.addEventListener('click', () => {
      if (!isLoggedIn) { alert('로그인 후 평가할 수 있습니다.'); return; }
      fetch(`/problems/${pid}/rate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rating: parseInt(s.dataset.val) })
      })
      .then(r => r.json())
      .then(data => {
        if (data.ok) {
          stars.forEach(x => x.classList.toggle('active', x.dataset.val <= s.dataset.val));
          document.getElementById('rating-info').innerHTML =
            `<strong>${data.avg}</strong> / 5 &nbsp;(${data.count}명 평가)`;
        }
      });
    });
  });
}
</script>

<%- include('partials/footer') %>
