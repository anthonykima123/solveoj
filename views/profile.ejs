<% locals.title = profileUser.username %>
<%- include('partials/header') %>

<div class="pf-wrap">

  <!-- 배너 + 아바타 -->
  <div class="pf-hero">
    <div class="pf-banner<%= bannerCss ? '' : ' pf-banner-default' %>"
      <% if (bannerCss) { %>style="background: <%= bannerCss %>"<% } %>></div>
    <div class="pf-hero-body">
      <div class="pf-avatar-box">
        <% if (profileUser.avatar_url) { %>
          <img src="<%= profileUser.avatar_url %>" class="pf-avatar" alt="<%= profileUser.username %>">
        <% } else { %>
          <div class="pf-avatar tier-emblem tier-<%= tier.cls %>"><%= emblem %></div>
        <% } %>
        <% if (rank > 0) { %><div class="pf-rank-chip">#<%= rank %></div><% } %>
      </div>
      <div class="pf-hero-right">
        <span class="pf-hero-stat"><strong><%= (profileUser.solved_count || 0).toLocaleString() %></strong> 문제해결</span>
      </div>
    </div>
  </div>

  <!-- 프로필 정보 -->
  <div class="pf-info">
    <div class="pf-handle">
      <%= profileUser.username %>
      <% if (profileUser.role === 'superadmin') { %><span class="role-pill super">관리자</span>
      <% } else if (profileUser.role === 'admin') { %><span class="role-pill">운영진</span><% } %>
    </div>
    <div class="pf-tier-row">
      <span class="pf-tier-label tier-text-<%= tier.cls %>"><%= tier.tier %> <strong><%= rating.toLocaleString() %></strong></span>
      <span class="pf-tier-next">
        <% if (next && nextTier) { %><%= nextTier.tier %> 승급까지 −<%= (next - rating).toLocaleString() %>점
        <% } else { %>🎉 최고 티어<% } %>
      </span>
    </div>
    <div class="pf-progress-track">
      <div class="pf-progress-fill tier-fill-<%= tier.cls %>" style="width:<%= progress %>%"></div>
    </div>
    <div class="pf-solved-sub"><%= (profileUser.solved_count || 0).toLocaleString() %>문제 해결</div>
    <% if (profileUser.solvedac_handle || profileUser.jungol_handle) { %>
    <div class="pf-ext-accounts">
      <% if (profileUser.solvedac_handle) { %>
        <a href="https://solved.ac/profile/<%= profileUser.solvedac_handle %>" target="_blank" rel="noopener" class="pf-ext-link">
          <span class="ext-badge ext-badge-solved">solved.ac</span>
          <span class="pf-ext-handle">@<%= profileUser.solvedac_handle %></span>
        </a>
      <% } %>
      <% if (profileUser.jungol_handle) { %>
        <a href="https://jungol.co.kr" target="_blank" rel="noopener" class="pf-ext-link">
          <span class="ext-badge ext-badge-jungol">정올</span>
          <span class="pf-ext-handle">@<%= profileUser.jungol_handle %></span>
        </a>
      <% } %>
    </div>
    <% } %>
  </div>

  <!-- 탭 -->
  <div class="pf-tabs">
    <button class="pf-tab active" onclick="pfTab(this,'overview')">개요</button>
    <button class="pf-tab" onclick="pfTab(this,'problems')">문제</button>
    <button class="pf-tab" onclick="pfTab(this,'recent')">최근 제출</button>
  </div>

  <!-- 개요 탭 -->
  <div class="pf-panel" id="pf-overview">

    <!-- AC Rating 카드 -->
    <div class="pf-card">
      <div class="pf-card-eyebrow">📈 AC RATING</div>
      <div class="pf-rating-header">
        <div class="pf-card-tier tier-text-<%= tier.cls %>"><%= tier.tier %> <strong><%= rating.toLocaleString() %></strong></div>
        <div class="pf-rank-pill">
          <span class="pf-rank-num">#<%= rank.toLocaleString() %></span>
          <span class="pf-rank-sub">전체 <%= totalUsers %>명</span>
        </div>
      </div>
      <div class="pf-top100-row">
        <span class="pf-top100-label">상위 100문제의 난이도 합</span>
        <span class="pf-top100-score">+ <%= top100Score.toLocaleString() %></span>
      </div>
      <% if (solvedBadges.length > 0) { %>
        <div class="pf-badge-grid">
          <% solvedBadges.forEach(b => { %>
            <a href="/problems/<%= b.id %>" class="pf-tier-dot tlb-<%= b.cls %>" title="<%= b.title %> (<%= b.difficulty %>)"><%= b.level %></a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted" style="margin-top:14px">아직 푼 문제가 없습니다.</p>
      <% } %>
    </div>

    <!-- 스트릭 카드 -->
    <div class="pf-card" style="margin-top:16px">
      <div class="pf-card-eyebrow">🔥 스트릭</div>
      <div class="pf-streak-now">현재 <strong><%= streak %></strong>일</div>
      <div class="heatmap-container">
        <div class="hm-ylabels">
          <% ['S','M','T','W','T','F','S'].forEach(l => { %><span><%= l %></span><% }) %>
        </div>
        <div class="hm-main">
          <div class="hm-grid">
            <% heatmapGrid.forEach(col => { %>
              <div class="hm-col">
                <% col.forEach(cell => { %>
                  <% if (cell === null) { %>
                    <div class="hm-cell hm-empty"></div>
                  <% } else if (cell.count > 0) { %>
                    <div class="hm-cell hm-lv<%= cell.level %>" title="<%= cell.key %>: <%= cell.count %>회"></div>
                  <% } else { %>
                    <div class="hm-cell hm-lv0"></div>
                  <% } %>
                <% }) %>
              </div>
            <% }) %>
          </div>
          <div class="hm-months">
            <% heatmapMonths.forEach(m => { %>
              <span style="left:<%= m.col * 13 %>px"><%= m.label %></span>
            <% }) %>
          </div>
        </div>
      </div>
      <div class="heatmap-footer">
        <span class="pf-maxstreak">최장 <strong><%= maxStreak %></strong>일 연속 문제 해결</span>
        <div class="hm-legend">
          <span class="hm-legend-label">적음</span>
          <div class="hm-cell hm-lv0"></div>
          <div class="hm-cell hm-lv1"></div>
          <div class="hm-cell hm-lv2"></div>
          <div class="hm-cell hm-lv3"></div>
          <div class="hm-cell hm-lv4"></div>
          <span class="hm-legend-label">많음</span>
        </div>
      </div>
    </div>

  </div>

  <!-- 문제 탭 -->
  <div class="pf-panel pf-hidden" id="pf-problems">
    <div class="pf-card">
      <h3>티어별 푼 문제</h3>
      <div class="tier-dist">
        <% TIERS.forEach(t => { %>
          <div class="dist-col">
            <div class="dist-bar-wrap">
              <div class="dist-bar tier-<%= t %>" style="height:<%= Math.round(dist[t] / maxDist * 100) %>%" title="<%= dist[t] %>"></div>
            </div>
            <div class="dist-count"><%= dist[t] %></div>
            <div class="dist-name tier-text-<%= t %>"><%= t.charAt(0).toUpperCase() + t.slice(1) %></div>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="pf-card" style="margin-top:16px">
      <h3>푼 문제 <span class="count-badge"><%= solvedProblems.length %></span></h3>
      <% if (solvedProblems.length === 0) { %>
        <p class="muted">아직 푼 문제가 없습니다.</p>
      <% } else { %>
        <div class="solved-grid" style="margin-top:10px">
          <% solvedProblems.forEach(p => { %>
            <a href="/problems/<%= p.id %>" class="solved-chip badge-<%= p.difficulty.toLowerCase().split(' ')[0] %>" title="<%= p.title %> (<%= p.difficulty %>)"><%= p.id %></a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- 최근 제출 탭 -->
  <div class="pf-panel pf-hidden" id="pf-recent">
    <div class="pf-card">
      <h3>최근 제출</h3>
      <% if (recent.length === 0) { %>
        <p class="muted">제출 기록이 없습니다.</p>
      <% } else { %>
        <div class="table-wrap" style="margin-top:10px">
          <table class="table">
            <thead><tr><th>문제</th><th>언어</th><th>결과</th><th>시간</th><th>제출일</th></tr></thead>
            <tbody>
              <% recent.forEach(s => { %>
                <tr>
                  <td><a href="/problems/<%= s.problem_id %>"><%= s.problem_id %>. <%= s.problem_title %></a></td>
                  <td><span class="lang-tag"><%= LANG_LABELS[s.language] || s.language %></span></td>
                  <td><a href="/submissions/<%= s.id %>" class="verdict verdict-<%= (s.verdict || '').toLowerCase() %>"><%= VERDICT_LABELS[s.verdict] || s.verdict %></a></td>
                  <td><%= s.execution_time || 0 %>ms</td>
                  <td><%= new Date(s.created_at).toLocaleString('ko-KR') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

</div>

<script>
function pfTab(btn, id) {
  document.querySelectorAll('.pf-tab').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.pf-panel').forEach(p => p.classList.add('pf-hidden'));
  btn.classList.add('active');
  document.getElementById('pf-' + id).classList.remove('pf-hidden');
}
</script>

<%- include('partials/footer') %>
